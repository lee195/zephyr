# Zephyr settings. Copy to .env (gitignored) in the folder you start the server from;
# Bun loads it on its own. A variable already set in the process wins over this file.
#
# This file never holds a key. The *_KEY_VAR settings name the variable that holds one,
# such as OPENAI_API_KEY; set that variable in the server's environment, from your password manager.

# Which model answers: vllm (any OpenAI-compatible chat endpoint, set below),
# claude-code (`claude -p` with your Claude Code login), or opencode (`opencode run` with your opencode providers).
ZEPHYR_BACKEND=vllm

# The chat endpoint, for ZEPHYR_BACKEND=vllm: OpenAI here, or any OpenAI-compatible server such as a local vLLM
# (http://127.0.0.1:8000/v1) or Ollama (http://127.0.0.1:11434/v1). The model must answer in JSON mode.
ZEPHYR_CHAT_URL=https://api.openai.com/v1
ZEPHYR_CHAT_MODEL=gpt-4.1-mini
ZEPHYR_CHAT_KEY_VAR=OPENAI_API_KEY

# For claude-code or opencode: a model to ask for, and the binary to run. Unset uses the harness's own default
# model and `claude` or `opencode` on PATH. For claude-code, a name or alias your account can use, as
# `claude --model <name>` takes it; for opencode, provider/model as `opencode models` lists it.
# ZEPHYR_HARNESS_MODEL=
# ZEPHYR_HARNESS_BIN=

# How notes and topics are matched: tfidf (local, no key) or embedding (the endpoint below, more accurate:
# 65% against 30% on the test corpus). Without the embedding key the server falls back to tfidf.
ZEPHYR_RELEVANCE=tfidf

# The embedding endpoint, for ZEPHYR_RELEVANCE=embedding. Its relatedness thresholds are measured per model, so
# far only for embeddinggemma2; for another model, measure them with scripts/measure-relevance.ts, or hints and
# link gating stay off.
# ZEPHYR_EMBED_URL=https://api.openai.com/v1
# ZEPHYR_EMBED_MODEL=text-embedding-3-small
# ZEPHYR_EMBED_KEY_VAR=OPENAI_API_KEY

# The server: port on 127.0.0.1, data folder, and minutes between cleanup sweeps.
ZEPHYR_PORT=7317
ZEPHYR_DATA=./data
ZEPHYR_SWEEP_MINUTES=30
